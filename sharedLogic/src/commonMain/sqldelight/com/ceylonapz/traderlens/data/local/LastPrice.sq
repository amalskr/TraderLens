-- Single row; the timestamp drives the stale price guard and "last updated" on offline launch.
CREATE TABLE lastPriceEntity (
    id INTEGER PRIMARY KEY NOT NULL CHECK (id = 1),
    price_cents INTEGER NOT NULL CHECK (price_cents > 0),
    timestamp_millis INTEGER NOT NULL
);

select:
SELECT price_cents, timestamp_millis FROM lastPriceEntity WHERE id = 1;

upsert:
INSERT OR REPLACE INTO lastPriceEntity(id, price_cents, timestamp_millis) VALUES (1, ?, ?);
